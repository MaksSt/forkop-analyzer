#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

service_enabled() {
	[ "$(uci -q get forkop-analyzer.main.enabled)" = "1" ]
}

start_service() {
	service_enabled || return 0

	procd_open_instance scheduler
	procd_set_param command /usr/bin/forkop-analyzer-scheduler
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$(uci -q get forkop-analyzer.main.monitor_enabled)" != '0' ]; then
		procd_open_instance monitor
		procd_set_param command /usr/bin/forkop-analyzer-monitor
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 0
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger forkop-analyzer
}

stop_service() {
	/usr/bin/forkop-analyzer cancel >/dev/null 2>&1 || true
	/usr/bin/forkop-analyzer cleanup >/dev/null 2>&1 || true
}
