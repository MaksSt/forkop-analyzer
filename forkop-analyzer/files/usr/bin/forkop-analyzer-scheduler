#!/bin/sh

RUNTIME_DIR="${FORKOP_ANALYZER_RUNTIME_DIR:-/var/run/forkop-analyzer}"
STATE_DIR="${FORKOP_ANALYZER_STATE_DIR:-/var/lib/forkop-analyzer}"
ANALYZER_BIN="${FORKOP_ANALYZER_BIN:-/usr/bin/forkop-analyzer}"
CHECK_INTERVAL_SECONDS="${FORKOP_ANALYZER_CHECK_INTERVAL_SECONDS:-300}"

prepare_dirs() {
	mkdir -p "$RUNTIME_DIR" "$STATE_DIR"
	chmod 700 "$RUNTIME_DIR" "$STATE_DIR"
}

run_schedule_check() {
	if [ "$(uci -q get forkop-analyzer.main.schedule_enabled)" != '1' ]; then
		return 0
	fi

	hour="$(uci -q get forkop-analyzer.main.schedule_hour)"
	case "$hour" in ''|*[!0-9]*) hour=4 ;; esac
	[ "$hour" -le 23 ] || hour=4
	current_hour="$(date '+%H' | sed 's/^0//')"
	[ -n "$current_hour" ] || current_hour=0
	today="$(date '+%Y-%m-%d')"
	last_day=''
	[ -f "$STATE_DIR/schedule-day" ] && last_day="$(sed -n '1p' "$STATE_DIR/schedule-day")"
	if [ "$current_hour" != "$hour" ] || [ "$last_day" = "$today" ]; then
		return 0
	fi

	profile="$(uci -q get forkop-analyzer.main.schedule_profile)"
	case "$profile" in quick|gaming|full) ;; *) profile=quick ;; esac
	if "$ANALYZER_BIN" start "$profile" >/dev/null 2>&1; then
		printf '%s\n' "$today" > "$STATE_DIR/schedule-day"
		chmod 600 "$STATE_DIR/schedule-day"
	fi
}

prepare_dirs

if [ "${FORKOP_ANALYZER_RUN_ONCE:-0}" = '1' ]; then
	run_schedule_check
	exit 0
fi

while true; do
	run_schedule_check
	sleep "$CHECK_INTERVAL_SECONDS"
done
